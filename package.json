{
  "name": "sports-betting-master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config apps/edgeboard/vite.config.ts && esbuild runtime/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:node:*",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "build:preview": "npm run build && node scripts/build-preview.mjs",
    "start:preview": "node runtime/preview-server.mjs",
    "test:node": "node --test tests/node/*.test.ts",
    "test:models": "node --test apps/edgeboard/tests/correctedReceiving.test.ts apps/edgeboard/tests/historicalCohort.test.ts",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:python": "python3 -m unittest discover -s edgeodds/tests -v && python3 -m unittest discover -s tests -v && python3 -m unittest discover -s apps/edgeboard/research/receiving60 -v",
    "test": "npm run verify:sources && npm run test:node && npm run test:models && npm run test:python"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  },
  "description": "Consolidated sports research workspace with eight traceable source repositories.",
  "repository": {
    "type": "git",
    "url": "https://github.com/danteclaird98/sports-betting-master"
  }
}
