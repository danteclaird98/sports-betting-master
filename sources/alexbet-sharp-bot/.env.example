# AlexBET Sharp Bot - Environment Configuration
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env to Git!

# ============ Telegram Bot API ============
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ============ Sports Odds API ============
ODDS_API_KEY=your_api_key_from_the_odds_api

# ============ Claude AI (Optional) ============
# Bot works without this, but Claude analysis will be disabled
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============ Whop Payments ============
WHOP_API_KEY=your_whop_api_key

# ============ Supabase Database (Telegram Stars Payments) ============
# Required for subscription persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============ Logging ============
LOG_LEVEL=info
LOG_FILE=logs/bot.log

# ============ Environment ============
NODE_ENV=development
