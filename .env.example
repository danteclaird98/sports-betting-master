# Server only. Never commit credentials.
HOST=127.0.0.1
PORT=3000
WORKSPACE_USER=owner
WORKSPACE_PASSWORD=
# Required when hosting publicly: choose a password of at least 16 characters.
# The runtime generates a new session-signing key on each restart unless set here.
WORKSPACE_SESSION_SECRET=
EDGEBOARD_DB=data/edgeboard.sqlite3
EDGEFUSION_DB=data/edgefusion.sqlite3
# For the current Fly deployment target, follow docs/FLY_DEPLOYMENT.md for HTTPS, allowed hosts and persistence.
# Copy provider keys from your provider dashboards into the host's server-side variables.
PARLAY_API_KEY=
CLEARSPORTS_API_KEY=
PUCKAPI_API_KEY=
SHARPAPI_API_KEY=
THE_ODDS_API_KEY=
SPORTSGAMEODDS_KEY=
